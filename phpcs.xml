<?xml version="1.0"?>
<ruleset name="FrontAccounting GraphQL">
    <description>Coding standard for the FrontAccounting GraphQL module.</description>

    <rule ref="PSR12"/>

    <!-- src/ and tests/ only. hooks.php is FrontAccounting-style by contract:
         a global, snake_case hooks_<module> class. php -l covers it. -->
    <file>src</file>
    <file>tests</file>
    <file>index.php</file>
    <file>app.php</file>
    <file>container.php</file>
    <!-- bin/fa-report and bin/fa-token have no extension, and phpcs skips such a file even when it
         is named here: composer's cs:check pipes it in as stdin with a .php
         stdin-path instead. -->

    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- FrontAccounting's own code, byte for byte: never reformatted. -->
    <exclude-pattern>*/src/Fa/fa_session_compat.php</exclude-pattern>

    <arg value="p"/>
    <arg name="colors"/>
    <arg value="s"/>
</ruleset>
