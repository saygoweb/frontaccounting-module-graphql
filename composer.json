{
    "name": "saygoweb/frontaccounting-module-graphql",
    "description": "A GraphQL API for FrontAccounting, delivered as a module",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "cambell",
            "email": "cambell.prince@gmail.com"
        }
    ],
    "repositories": {
        "anorm-graphql": {
            "type": "vcs",
            "url": "https://github.com/saygoweb/anorm-graphql"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "lcobucci/jwt": "^4.0",
        "php-di/php-di": "^6.0",
        "saygoweb/anorm": "^3.2.1",
        "saygoweb/anorm-graphql": "^0.3",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.11",
        "webonyx/graphql-php": "^15.32.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "FA\\GraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FA\\GraphQL\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "lint": "find . -name vendor -prune -o -type f \\( -name '*.php' -o -path ./bin/fa-report \\) -print0 | xargs -0 -n1 php -l",
        "cs:check": [
            "phpcs",
            "phpcs --stdin-path=bin/fa-report.php - < bin/fa-report"
        ],
        "cs:fix": "phpcbf",
        "analyze": "phpstan analyse --no-progress --memory-limit=512M",
        "generate": "bin/generate",
        "quality": [
            "@lint",
            "@cs:check",
            "@analyze"
        ],
        "ci": [
            "@quality",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite. The http tests need the module served from a FrontAccounting install - docker/fa-graphql test does that.",
        "lint": "php -l over every PHP file in the module, bin/fa-report included.",
        "cs:check": "Check src/, tests/ and bin/fa-report against PSR-12 (phpcs.xml).",
        "cs:fix": "Fix what phpcbf can fix automatically.",
        "analyze": "Run PHPStan over src/ (phpstan.neon).",
        "generate": "anorm-graphql make with this module's options (bin/generate). Runs on the host too: bin/generate.",
        "quality": "lint, cs:check, then analyze.",
        "ci": "quality, then test - the gates docker/fa-graphql ci runs."
    }
}
