{
    "name": "saygoweb/frontaccounting-module-graphql",
    "description": "A GraphQL API for FrontAccounting, delivered as a module",
    "type": "project",
    "authors": [
        {
            "name": "cambell",
            "email": "cambell.prince@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "php-di/php-di": "^6.0",
        "saygoweb/anorm": "^3.2.1",
        "webonyx/graphql-php": "^15.32.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "FA\\GraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FA\\GraphQL\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "lint": "find . -name vendor -prune -o -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf",
        "analyze": "phpstan analyse --no-progress --memory-limit=512M",
        "quality": [
            "@lint",
            "@cs:check",
            "@analyze"
        ],
        "ci": [
            "@quality",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite. The http tests need the module served from a FrontAccounting install - docker/fa-graphql test does that.",
        "lint": "php -l over every PHP file in the module.",
        "cs:check": "Check src/ and tests/ against PSR-12 (phpcs.xml).",
        "cs:fix": "Fix what phpcbf can fix automatically.",
        "analyze": "Run PHPStan over src/ (phpstan.neon).",
        "quality": "lint, cs:check, then analyze.",
        "ci": "quality, then test - the gates docker/fa-graphql ci runs."
    }
}
