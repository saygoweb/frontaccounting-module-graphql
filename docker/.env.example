# Settings for the docker/ test stack. Copy to docker/.env, or let
# `docker/fa-graphql init` write one with ports that are free on this machine.
#
# Every value here is a default that docker/fa-graphql already applies — this
# file exists to show what can be changed, not because anything must be.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Containers and the database volume are named after this. It defaults to
# fa-graphql-<checkout directory name>, which is what keeps a worktree's stack
# separate from the main checkout's.
#COMPOSE_PROJECT_NAME=fa-graphql-graphql

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------

# Clear of the FrontAccounting stack (8080/3307/8081), the modules/api stack
# (8090/3309/8091) and the Anorm stacks (3316-3319, 8096-8099), so all of them
# can run at once. Inside the container Apache is always on 8000.
#HTTP_PORT=8100
#DB_PORT=3320
#PMA_PORT=8101

# ---------------------------------------------------------------------------
# FrontAccounting
# ---------------------------------------------------------------------------

# The application this module plugs into, cloned into the image at build time.
# Upstream master by default. To build the cambell-prince fork instead:
#
#   FA_REPO=https://github.com/cambell-prince/frontaccounting.git
#   FA_REF=master-cp
#
# A shallow clone needs a branch or a tag; a bare commit sha will not work.
# Changing either needs `docker/fa-graphql up --build`.
#FA_REPO=https://github.com/FrontAccountingERP/FA.git
#FA_REF=master

# ---------------------------------------------------------------------------
# sgw_sales
# ---------------------------------------------------------------------------

# The recurring-sales module this API drives in Release 2, cloned into
# /var/www/html/modules/sgw_sales at build time like FrontAccounting itself.
# Changing either needs `docker/fa-graphql up --build`.
#SGW_SALES_REPO=https://github.com/saygoweb/frontaccounting-module-sgw_sales.git
#SGW_SALES_REF=master

# Registers it as extension 2 and applies its sql/update_1.0.sql and
# update_1.4.sql on `docker/fa-graphql db load`. false leaves it cloned but
# unregistered.
#SGW_SALES_ACTIVE=true

# ---------------------------------------------------------------------------
# Packages under development
# ---------------------------------------------------------------------------

# A checkout of saygoweb/anorm-graphql on the host. When set, it is mounted
# read-only at /opt/anorm-graphql in the app container, where a composer `path`
# repository can find it. Needs `docker/fa-graphql up` to take effect.
#ANORM_GRAPHQL_PATH=/home/you/src/anorm-graphql

# A checkout of saygoweb/frontaccounting-module-sgw_sales on the host, bind-mounted
# over the clone in the image so both repositories can be worked on at once. It
# needs its own `composer install --no-dev` (docker/fa-graphql exec runs it there
# too). Needs `docker/fa-graphql up` to take effect.
#SGW_SALES_PATH=/home/you/src/frontaccounting-module-sgw_sales

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

# Any version sury publishes for Debian trixie: 7.4, 8.0 ... 8.4. 7.4 is the
# floor Anorm and anorm-graphql support, the platform composer.json resolves
# the lock against, and the newest FrontAccounting 2.4.x is known to run on.
#PHP_VERSION=7.4

#MARIADB_VERSION=10.11

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The entrypoint writes these into FrontAccounting's config_db.php on every
# start.
#DB_NAME=fa_graphql
#DB_USER=fa
#DB_PASSWORD=fa
#DB_ROOT_PASSWORD=fa

# The table prefix. Datasets ship with 0_ baked in; anything else is rewritten
# as it loads.
#DB_PREFIX=0_

# What `fa-graphql up` loads into an empty database, and the default for
# `fa-graphql db reset`: demo or new. Both are FrontAccounting's own installer
# datasets; the login is admin / password.
#SEED=demo

# ---------------------------------------------------------------------------
# PHP
# ---------------------------------------------------------------------------

# Leave xdebug off unless you are attaching to it — it costs real time on every
# request. "debug" enables step debugging on port 9003, triggered by
# XDEBUG_TRIGGER; "coverage" is what phpunit --coverage-html needs.
#
# docker/fa-graphql folds "develop" into whatever you set, because FA calls
# xdebug_call_file() and xdebug 3 only provides it in that mode.
#XDEBUG_MODE=off

# The extension is compiled in unless this is false at build time.
#INSTALL_XDEBUG=true

#FA_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Host user
# ---------------------------------------------------------------------------

# Apache and composer run as www-data remapped to these, so vendor/ and anything
# else written into the bind-mounted checkout stays yours. docker/fa-graphql
# fills them in from `id -u`/`id -g`.
#USER_UID=1000
#USER_GID=1000
