parameters:
    level: 5

    # FrontAccounting is a .inc codebase. Without this, scanDirectories below
    # finds almost none of it.
    fileExtensions:
        - php
        - inc

    paths:
        - src
        - app.php
        - container.php
        - index.php

    # FrontAccounting's own code, byte for byte (it still calls
    # get_magic_quotes_gpc() behind a PHP < 5.4 check). FrontAccounting is
    # scanned for symbols, never analysed; this copy of it is no different.
    excludePaths:
        analyse:
            - src/Fa/fa_session_compat.php

    # FrontAccounting itself, two directories up: this module lives at
    # modules/graphql inside an FA tree, and that is equally true inside the
    # docker stack, where the checkout is bind-mounted at
    # /var/www/html/modules/graphql. Read for symbols only, never analysed.
    scanDirectories:
        - ../../includes

    # front_accounting itself lives at the FA root, not under includes/.
    scanFiles:
        - ../../frontaccounting.php
