parameters:
    level: 5

    # FrontAccounting is a .inc codebase. Without this, scanDirectories below
    # finds almost none of it.
    fileExtensions:
        - php
        - inc

    paths:
        - src
        - app.php
        - container.php
        - index.php
        - bin/fa-report
        - bin/fa-token

    # FrontAccounting's own code, byte for byte (it still calls
    # get_magic_quotes_gpc() behind a PHP < 5.4 check). FrontAccounting is
    # scanned for symbols, never analysed; this copy of it is no different.
    excludePaths:
        analyse:
            - src/Fa/fa_session_compat.php

    # FrontAccounting itself, two directories up: this module lives at
    # modules/graphql inside an FA tree, and that is equally true inside the
    # FrontAccounting CI image, where the checkout is mounted at
    # /var/www/html/modules/graphql. Read for symbols only, never analysed.
    scanDirectories:
        - ../../includes

    # front_accounting itself lives at the FA root, not under includes/.
    scanFiles:
        - ../../frontaccounting.php
        # CustomerService: add_customer, update_customer, delete_customer,
        # get_customer, get_customer_by_ref (customers_db.inc), add_branch
        # (branches_db.inc), key_in_foreign_table, get_company_pref
        # (company_db.inc, loaded by sysprefs.inc).
        - ../../sales/includes/db/customers_db.inc
        - ../../sales/includes/db/branches_db.inc
        - ../../includes/db/crm_contacts_db.inc
        - ../../admin/db/company_db.inc
        - ../../includes/banking.inc
        - ../../includes/db/sql_functions.inc
        # SalesOrderService: the Cart and what it is filled with (cart_class.inc,
        # sales_order_ui.inc, sales_order_db.inc, sales_db.inc, sales_types_db.inc),
        # items and locations, fiscal years, shippers, costs.
        - ../../sales/includes/cart_class.inc
        - ../../sales/includes/ui/sales_order_ui.inc
        - ../../sales/includes/db/sales_order_db.inc
        - ../../sales/includes/sales_db.inc
        - ../../sales/includes/db/sales_types_db.inc
        - ../../inventory/includes/db/items_codes_db.inc
        - ../../inventory/includes/db/items_locations_db.inc
        - ../../admin/db/fiscalyears_db.inc
        - ../../admin/db/shipping_db.inc
        # Voider: void_transaction, get_voided_entry (admin/ is not under
        # scanDirectories' includes/).
        - ../../admin/db/voiding_db.inc
        # DeliveryService: adjust_shipping_charge (sales_delivery_db.inc).
        - ../../sales/includes/db/sales_delivery_db.inc
        # CustomerPaymentService, CustomerPaymentType: write_customer_payment,
        # get_cust_bank_charge (payment_db.inc); get_bank_account,
        # get_bank_charge_account (gl_db_bank_accounts.inc); get_gl_account
        # (gl_db_accounts.inc).
        - ../../sales/includes/db/payment_db.inc
        - ../../gl/includes/db/gl_db_bank_accounts.inc
        - ../../gl/includes/db/gl_db_accounts.inc
